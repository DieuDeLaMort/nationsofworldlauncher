<div id="login-view" style="display: none;">
    <div class="login-content">
        <div class="login-head">
            <h1 class="title">Connectez-vous !</h1>
            <p class="desc">
                Utilisez votre compte <a href="https://account.microsoft.com/">Microsoft</a> pour vous connecter.
                <br>Votre compte doit posséder le jeu Minecraft <a href="https://www.minecraft.net/fr-fr/store/minecraft-java-bedrock-edition-pc">Java Édition</a> !
            </p>
            <hr>
        </div>
        <div class="login-body">
            <form id="login-form">
                <button class="button button-gradient" id="login-button" type="button">Se connecter avec Microsoft <div class="circle-loader" id="login-button-loader" style="display: none;"></div></button>
                
                <span class='help-button' id="login-help-button"><i class="fas fa-question"></i></span>
            </form>
        </div>
    </div>

    <script src="./assets/js/scripts/login.js"></script>
</div>