<div id="login-view" style="display: none;">
    <div class="login-content">
        <div class="login-head">
            <h1 class="title">Connectez-vous !</h1>
            <p class="desc">
                Connectez-vous avec votre compte <a href="https://account.microsoft.com/">Microsoft</a>
                ou utilisez le mode hors-ligne (crack).
            </p>
            <hr>
        </div>
        <div class="login-body">
            <form id="login-form">
                <!-- Microsoft Login -->
                <button class="button button-gradient" id="login-button" type="button">
                    <i class="fab fa-microsoft"></i> Se connecter avec Microsoft
                    <div class="circle-loader" id="login-button-loader" style="display: none;"></div>
                </button>

                <div class="login-divider">
                    <span>OU</span>
                </div>

                <!-- Offline / Crack Login -->
                <div class="form-group">
                    <p>Pseudo Minecraft (mode hors-ligne)</p>
                    <input id="login-offline-username" class="textfield" type="text" placeholder="Entrez votre pseudo..." maxlength="16" autocomplete="off">
                </div>
                <button class="button button-offline" id="login-offline-button" type="button">
                    Jouer en hors-ligne
                    <div class="circle-loader" id="login-offline-button-loader" style="display: none;"></div>
                </button>

                <span class='help-button' id="login-help-button"><i class="fas fa-question"></i></span>
            </form>
        </div>
    </div>

    <script src="./assets/js/scripts/login.js"></script>
</div>